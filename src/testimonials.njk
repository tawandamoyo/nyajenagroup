---js
{
  layout: "layouts/base.njk",
  // Not built until testimonials.json has approved quotes in it.
  permalink: (data) => (data.testimonials.length ? "/testimonials.html" : false),
  eleventyComputed: {
    eleventyExcludeFromCollections: (data) => !data.testimonials.length,
  },
  title: "Farmer stories",
  description: "Farmers across Zimbabwe on what changed after working with Nyajena Agricultural Group, from day-old chicks and broilers to layers, rabbits and goats.",
}
---
<nav class="wrap crumbs" aria-label="Breadcrumb">
  <ol role="list">
    <li><a href="/">Home</a></li>
    <li><a href="/testimonials.html" aria-current="page">Farmer stories</a></li>
  </ol>
</nav>

<section class="section section--flush-top">
  <div class="wrap">
    <header class="section__head">
      <h1>Farmer stories</h1>
      <p class="lede">Farmers we supply, in their own words.</p>
    </header>
    <div class="quotes quotes--all">
      {%- for t in testimonials %}
      <figure class="quote">
        <p class="quote__tag">{{ t.product }}</p>
        <blockquote><p>{{ t.quote }}</p></blockquote>
        <figcaption>
          <strong>{{ t.name }}</strong>
          <span>{{ t.detail }}, {{ t.place }}</span>
        </figcaption>
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap split split--top">
    <div class="split__text">
      <h2>Planning your own flock or herd?</h2>
      <p>Tell us what you need and ask what stock and support are available for your farm.</p>
    </div>
    <ul class="ticks" role="list">
      <li>Confirm stock type, age, quantity and health records.</li>
      <li>Ask about housing, feed and equipment before arrival.</li>
      <li>Check delivery dates and the full cost before booking.</li>
      <li>Discuss aftercare and any fees with our team.</li>
    </ul>
  </div>
</section>

{% set orderBandTitle = "Order your first batch" %}
{% include "partials/order-band.njk" %}
