---
layout: layouts/base.njk
permalink: /order.html
title: Order stock
description: Order day-old chicks, broilers, layers, guinea fowl, turkeys, ducks, rabbits or goats from Nyajena Agricultural Group in Masvingo. Send your order on WhatsApp and get a price and delivery date within one business day.
hideFab: true
---
<section class="section order-page">
  <div class="wrap order-page__inner">
    <div class="order-page__intro">
      <h1>Order stock</h1>
      <p class="lede">Fill this in and we’ll open WhatsApp with your order ready to send. We reply within one business day with a price and delivery date.</p>
      <p class="hint">Order at least {{ site.leadTimeWeeks }} weeks before you want delivery.</p>
    </div>

    <noscript>
      <p class="notice">To order, <a href="https://wa.me/{{ site.whatsapp }}">message us on WhatsApp</a> or <a href="tel:{{ site.phone.e164 }}">call {{ site.phone.display }}</a>.</p>
    </noscript>

    <form
      class="order-form"
      id="order-form"
      novalidate
      data-whatsapp="{{ site.whatsapp }}"
      data-lead-days="{{ site.leadTimeWeeks * 7 }}"
    >
      <p class="field-error" id="form-error-summary" role="alert" hidden>Please check the highlighted fields before continuing.</p>
      <fieldset class="field-group" aria-describedby="stock-error">
        <legend>What do you need?</legend>
        <p class="hint" id="quantity-hint">Choose your stock and add an approximate quantity, or leave the quantity blank if you’re unsure.</p>
        <p class="notice" id="stock-group-hint" hidden>Choose the stock you want below. None have been selected for you.</p>
        <ul class="stock-picker" role="list">
          {%- for opt in orderOptions %}
          <li class="stock-picker__row">
            <input type="checkbox" id="stock-{{ opt.value }}" name="stock" value="{{ opt.value }}" data-label="{{ opt.label }}" />
            <label for="stock-{{ opt.value }}">{{ opt.label }}</label>
            <span class="stock-picker__qty">
              <label class="visually-hidden" for="qty-{{ opt.value }}">How many {{ opt.label | lower }}?</label>
              <input type="text" id="qty-{{ opt.value }}" name="qty-{{ opt.value }}" inputmode="numeric" placeholder="e.g. {{ opt.example }}" aria-describedby="quantity-hint qty-error-{{ opt.value }}" disabled />
              <span aria-hidden="true">{{ opt.unit }}</span>
            </span>
            <p class="field-error stock-picker__error" id="qty-error-{{ opt.value }}" hidden>Enter a whole number above zero, or leave this blank if you’re unsure.</p>
            {%- if opt.variants %}
            <div class="stock-picker__details" id="details-{{ opt.value }}" hidden>
              <label for="variant-{{ opt.value }}">{{ opt.variantLabel }}</label>
              <select id="variant-{{ opt.value }}" name="variant-{{ opt.value }}" disabled>
                <option value="">Not sure — please advise</option>
                {%- for variant in opt.variants %}
                <option value="{{ variant }}">{{ variant }}</option>
                {%- endfor %}
              </select>
            </div>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>
        <p class="field-error" id="stock-error" hidden>Choose at least one type of stock.</p>
        <div class="check">
          <input type="checkbox" id="extras" name="extras" />
          <label for="extras">Also quote me for feed, vaccines or brooding equipment</label>
        </div>
      </fieldset>

      <fieldset class="field-group">
        <legend>Location and timing</legend>
        <div class="field">
          <label for="location">Town or district</label>
          <input type="text" id="location" name="location" autocomplete="address-level2" required aria-describedby="location-error" />
          <p class="field-error" id="location-error" hidden>Enter your town or district so we can discuss delivery options.</p>
        </div>
        <div class="field">
          <label for="date">Preferred date <span class="optional">(optional)</span></label>
          <input type="date" id="date" name="date" aria-describedby="date-hint date-error" />
          <p class="hint" id="date-hint">Earliest we can usually deliver: <span data-earliest>{{ site.leadTimeWeeks }} weeks from today</span>. Need it sooner? Pick your date and we’ll tell you what’s ready.</p>
          <p class="field-error" id="date-error" hidden>Choose today or a future date, or leave this blank.</p>
        </div>
      </fieldset>

      <fieldset class="field-group">
        <legend>Your details</legend>
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required aria-describedby="name-error" />
          <p class="field-error" id="name-error" hidden>Enter your name.</p>
        </div>
        <div class="field">
          <label for="phone">Phone or WhatsApp number</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" required aria-describedby="phone-error" placeholder="e.g. 077 123 4567" />
          <p class="field-error" id="phone-error" hidden>Enter a phone number with 7–15 digits. Spaces and a country code are fine.</p>
        </div>
        <div class="field">
          <label for="notes">Questions or preferences <span class="optional">(optional)</span></label>
          <textarea id="notes" name="notes" rows="3" placeholder="A breed, age or sex you need, collection preferences, or questions about your setup"></textarea>
        </div>
      </fieldset>

      <p class="privacy">Nothing is sent until you tap Send in WhatsApp. We reply with a price and delivery date, and your order is booked once you’ve agreed them with us.</p>

      <button class="button button--primary button--block" type="submit" disabled>
        <svg aria-hidden="true"><use href="#i-whatsapp" /></svg>Continue to WhatsApp
      </button>
      <p class="order-page__call">Prefer to talk? <a href="tel:{{ site.phone.e164 }}">Call {{ site.phone.display }}</a>.</p>
    </form>

    <section class="order-sent" id="order-sent" hidden tabindex="-1" aria-labelledby="order-sent-title">
      <h2 id="order-sent-title">Your order is ready to send</h2>
      <p>Tap Send in WhatsApp to reach us. If WhatsApp didn’t open, use the button below or copy your order.</p>
      <div class="actions">
        <a class="button button--primary" id="order-sent-link" href="https://wa.me/{{ site.whatsapp }}" rel="noopener">
          <svg aria-hidden="true"><use href="#i-whatsapp" /></svg>Open WhatsApp
        </a>
        <button class="button button--ghost" type="button" id="order-copy">Copy order</button>
      </div>
      <p class="visually-hidden" role="status" id="order-copy-status"></p>
      <label class="visually-hidden" for="order-text">Your order</label>
      <textarea id="order-text" rows="9" readonly></textarea>
      <p>Or call us on <a href="tel:{{ site.phone.e164 }}">{{ site.phone.display }}</a>. <button class="link-button" type="button" id="order-edit">Change my order</button></p>
    </section>
  </div>
</section>
