---
layout: layouts/base.njk
pagination:
  data: products
  size: 1
  alias: product
permalink: "{{ product.url }}"
eleventyComputed:
  title: "{{ product.title }}"
  description: "{{ product.description }}"
  orderStock: "{{ product.orderOptions[0] if product.orderOptions.length == 1 else '' }}"
  stockGroup: "{{ product.slug if product.orderOptions.length > 1 else '' }}"
  orderBandTitle: "Order {{ product.name | lower }}"
---
<nav class="wrap crumbs" aria-label="Breadcrumb">
  <ol role="list">
    <li><a href="/">Home</a></li>
    <li><a href="/#stock">Our stock</a></li>
    <li><a href="{{ product.url }}" aria-current="page">{{ product.name }}</a></li>
  </ol>
</nav>

<section class="product-hero">
  <div class="wrap product-hero__inner">
    <div class="product-hero__text">
      <h1>{{ product.name }}</h1>
      <p class="lede">{{ product.lede }}</p>
      {%- for para in product.intro %}
      <p>{{ para }}</p>
      {%- endfor %}
      <div class="actions">
        <a class="button button--primary" href="/order.html?{% if orderStock %}stock={{ orderStock }}{% else %}group={{ stockGroup }}{% endif %}">Order {{ product.name | lower }}</a>
        <a class="button button--ghost" href="https://wa.me/{{ site.whatsapp }}?text={{ ('Hi Nyajena, I have a question about ' + (product.name | lower) + '.') | urlencode }}" rel="noopener">
          <svg aria-hidden="true"><use href="#i-whatsapp" /></svg>Ask a question
        </a>
      </div>
    </div>

    <div class="product-hero__aside">
      <figure class="product-hero__media">
        {% image product.image, product.alt, "(min-width: 60em) 40vw, 100vw", { eager: true, focus: product.focus } %}
      </figure>
      <section class="spec" aria-labelledby="spec-title">
        <h2 class="spec__title" id="spec-title">At a glance</h2>
        <dl>
          {%- for f in product.facts %}
          <div><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>
          {%- endfor %}
        </dl>
      </section>
    </div>

    <div class="product-hero__lists">
      {%- for g in product.groups %}
      <article class="column" id="{{ g.id }}">
        <h2>{{ g.name }}</h2>
        <p>{{ g.text }}</p>
        <a class="text-link" href="/order.html?stock={{ g.id }}">Order {{ g.name | lower }}</a>
      </article>
      {%- endfor %}
      {%- for list in product.lists %}
      <div class="column">
        <h2>{{ list.heading }}</h2>
        {%- if list.items %}
        <ul class="ticks" role="list">
          {%- for item in list.items %}
          <li>{{ item }}</li>
          {%- endfor %}
        </ul>
        {%- else %}
        <p>{{ list.text }}</p>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>


<section class="section section--tint" aria-labelledby="related-title">
  <div class="wrap">
    <header class="section__head section__head--row">
      <h2 id="related-title">Other stock</h2>
      <a class="text-link" href="/#stock">See all stock</a>
    </header>
    {%- set stockItems = products | productsBySlugs(product.related) %}
    {%- set stockHeading = "h3" %}
    {% include "partials/stock-list.njk" %}
  </div>
</section>

{% include "partials/order-band.njk" %}
