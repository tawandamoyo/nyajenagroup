<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">{{ site.name }}</p>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
      <p>Supplying farmers since {{ site.founded }}. Contact us for current stock, prices and delivery options.</p>
    </div>

    <div>
      <h2 class="site-footer__heading">Stock</h2>
      <ul>
        {%- for p in products %}
        <li><a href="{{ p.url }}">{{ p.navName or p.name }}</a></li>
        {%- endfor %}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Company</h2>
      <ul>
        <li><a href="/about.html">About us</a></li>
        {%- if testimonials.length %}
        <li><a href="/testimonials.html">Farmer stories</a></li>
        {%- endif %}
        <li><a href="/#faq">Questions</a></li>
        <li><a href="/order.html">Order stock</a></li>
      </ul>
    </div>

    <div id="contact">
      <h2 class="site-footer__heading">Contact</h2>
      <ul class="site-footer__contact">
        <li><a href="tel:{{ site.phone.e164 }}"><svg aria-hidden="true"><use href="#i-phone" /></svg>{{ site.phone.display }}</a></li>
        <li><a href="https://wa.me/{{ site.whatsapp }}" rel="noopener"><svg aria-hidden="true"><use href="#i-whatsapp" /></svg>WhatsApp us</a></li>
        {%- if site.email %}
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        {%- endif %}
        <li><svg aria-hidden="true"><use href="#i-pin" /></svg><address>{{ site.address.street }}, {{ site.address.locality }}, {{ site.address.countryName }}</address></li>
      </ul>
      {%- if site.social.length %}
      <ul class="site-footer__social">
        {%- for s in site.social %}
        <li><a href="{{ s.url }}" rel="noopener">{{ s.name }}</a></li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>
  </div>
  <div class="wrap site-footer__base">
    <p>&copy; {{ buildYear }} {{ site.name }}</p>
    <p>Site by <a href="https://moyo.build" rel="noopener">Moyo</a></p>
  </div>
</footer>
